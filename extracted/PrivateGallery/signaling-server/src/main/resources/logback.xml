<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern></encoder>
    </appender>
    <!-- CRITICAL: never log request bodies (see Application.kt's CallLogging config) — bodies
         may contain ciphertext blobs, wrapped keys, or JWTs. Only method/path/status are logged. -->
    <root level="INFO"><appender-ref ref="STDOUT" /></root>
</configuration>
